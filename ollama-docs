#!/usr/bin/env bash
# Launcher script for Ollama Document Repository

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Activate the virtualenv if one exists (support both .venv and venv)
if [ -d ".venv" ]; then
    source .venv/bin/activate
elif [ -d "venv" ]; then
    source venv/bin/activate
fi

# Run the CLI (no subcommand -> TUI; subcommand -> one-shot action)
exec python -m src.main "$@"
